ub":"3X11 &middot; December 15, 1995","links":[["The scripts","/x-files-scripts-by-season/season-3/#ep-3x11"]]}],"12-07":[{"year":1997,"kind":"aired","rank":0,"img":"/assets/archive-photos/scripts-season-5-06.webp","t":"Christmas Carol","c":"5X05","l":"Christmas Carol aired","text":"<b>Christmas Carol</b> aired for the first time.","sub":"5X05 &middot; December 7, 1997","links":[["The scripts","/x-files-scripts-by-season/season-5/#ep-5x05"]]}],"12-14":[{"year":1997,"kind":"aired","rank":0,"img":"/assets/archive-photos/scripts-season-5-07.webp","t":"Emily","c":"5X07","l":"Emily aired","text":"<b>Emily</b> aired for the first time.","sub":"5X07 &middot; December 14, 1997","links":[["The scripts","/x-files-scripts-by-season/season-5/#ep-5x07"]]}],"12-06":[{"year":1998,"kind":"aired","rank":0,"img":"/assets/archive-photos/scripts-season-6-05.webp","t":"Dreamland II","c":"6ABX05","l":"Dreamland II aired","text":"<b>Dreamland II</b> aired for the first time.","sub":"6ABX05 &middot; December 6, 1998","links":[["The scripts","/x-files-scripts-by-season/season-6/#ep-6abx05"]]}],"12-13":[{"year":1998,"kind":"aired","rank":0,"img":"/assets/archive-photos/scripts-season-6-06.webp","t":"How the Ghosts Stole Christmas","c":"6ABX08","l":"How the Ghosts Stole Christmas aired","text":"<b>How the Ghosts Stole Christmas</b> aired for the first time.","sub":"6ABX08 &middot; December 13, 1998","links":[["The scripts","/x-files-scripts-by-season/season-6/#ep-6abx08"]]}],"12-05":[{"year":1999,"kind":"note","rank":-1,"l":"Rush aired","t":"Rush","c":"7ABX06","img":"/assets/archive-photos/scripts-season-7-05.webp","text":"<b>Rush</b> aired! The September 17, 1999 draft is still &ldquo;Untitled,&rdquo; and it didn't even have a story number yet. The title page says &ldquo;Story No. E00???&rdquo;","sub":"7ABX06 &middot; December 5, 1999","links":[["Read the draft","https://drive.google.com/file/d/1HbGAMiFqlLRIHGhK-XK14MWbTPifPtxv/view?usp=sharing"],["The scripts","/x-files-scripts-by-season/season-7/#ep-7abx06"]]}],"12-12":[{"year":1999,"kind":"aired","rank":0,"img":"/assets/archive-photos/scripts-season-7-06.webp","t":"The Goldberg Variation","c":"7ABX02","l":"The Goldberg Variation aired","text":"<b>The Goldberg Variation</b> aired for the first time.","sub":"7ABX02 &middot; December 12, 1999","links":[["The scripts","/x-files-scripts-by-season/season-7/#ep-7abx02"]]}],"12-03":[{"year":2000,"kind":"note","rank":-1,"l":"Invocation aired","t":"Invocation","c":"8ABX06","img":"/assets/archive-photos/scripts-season-8-05.webp","text":"<b>Invocation</b> aired! Its title page shows how fast it came together: &ldquo;Teaser &amp; Act 1 Only&rdquo; on September 8, 2000, a full draft three days later, and the Production Draft on September 15.","sub":"8ABX06 &middot; December 3, 2000","links":[["Read the Production Draft","https://drive.google.com/file/d/1Vvj4f-oxBhxsRnFC0skzNKuh2PX-7K2h/view?usp=share_link"],["The scripts","/x-files-scripts-by-season/season-8/#ep-8abx06"]]}],"12-02":[{"year":2001,"kind":"note","rank":-1,"l":"Daemonicus aired","t":"Daemonicus","c":"9ABX03","img":"/assets/archive-photos/scripts-season-9-03.webp","text":"<b>Daemonicus</b> aired, written and directed by Frank Spotnitz. The teaser is a Scrabble game: seven tiles spell out &ldquo;TRIUMPH,&rdquo; and Darren gets to say &ldquo;Read 'em and weep, my dear.&rdquo;","sub":"9ABX03 &middot; December 2, 2001","links":[["Read the Final","https://drive.google.com/file/d/1Zy4BG_odwlA2EaiiwOTc3S5XMk5eFjSg/view?usp=share_link"],["The scripts","/x-files-scripts-by-season/season-9/#ep-9abx03"]]}],"12-08":[{"year":1999,"kind":"draft","rank":2,"img":"/assets/archive-photos/scripts-season-7-11.webp","t":"Closure","c":"7ABX11","l":"Closure, Gold revision","text":"The Gold revision of <b>Closure</b> is dated today.","sub":"7ABX11 &middot; December 8, 1999","links":[["Read the draft","https://drive.google.com/file/d/1BhlWu5pp54ih--4FcTLSXi7-j1x_TUFe/view?usp=share_link"],["The scripts","/x-files-scripts-by-season/season-7/#ep-7abx11"]]}],"12-04":[{"year":1998,"kind":"note","rank":-1,"l":"Arcadia, Production Draft","t":"Arcadia","c":"6ABX13","img":"/assets/archive-photos/scripts-season-6-15.webp","text":"The Production Draft of <b>Arcadia</b> is dated today, and it's still &ldquo;Untitled.&rdquo; Mulder is already having way too much fun playing house: &ldquo;You didn't let me carry you over the threshold.&rdquo; And then: &ldquo;Woman?! Make me a sandwich!&rdquo;","sub":"6ABX13 &middot; December 4, 1998","links":[["Read the Production Draft","https://drive.google.com/file/d/1SPwjhSW0EW-BGGf-FOn5eypXqLJP1QgE/view?usp=sharing"],["The scripts","/x-files-scripts-by-season/season-6/#ep-6abx13"]]}]}