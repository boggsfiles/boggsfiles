 "splits": {
  "33": [
   {
    "text": "Do over?",
    "speaker": "Rogers"
   },
   {
    "text": "That's it?",
    "speaker": "Cynthia"
   }
  ],
  "121": [
   {
    "text": "Yes.",
    "speaker": "Lindquist"
   },
   {
    "text": "In that case, I'd like to see all of the tapes.",
    "speaker": "Dana Scully"
   }
  ],
  "122": [
   {
    "text": "As soon as possible.",
    "speaker": "Dana Scully"
   },
   {
    "text": "All right.",
    "speaker": "Lindquist"
   }
  ],
  "148": [
   {
    "text": "Is that guy bothering you?",
    "speaker": "Bar Patron"
   },
   {
    "text": "Not yet.",
    "speaker": "Gupta"
   }
  ],
  "188": [
   {
    "text": "About work?",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Yeah.",
    "speaker": "Gupta"
   }
  ],
  "362": [
   {
    "text": "What's your name?",
    "speaker": "Dana Scully"
   },
   {
    "text": "Agnes.",
    "speaker": "Agnes"
   }
  ],
  "507": [
   {
    "text": "Molly!",
    "speaker": "Dr. Goldman"
   },
   {
    "text": "Let go of me!",
    "speaker": "Molly"
   }
  ],
  "514": [
   {
    "text": "Let go of me!",
    "speaker": "Molly"
   },
   {
    "text": "Molly! Molly!",
    "speaker": "Dr. Goldman"
   }
  ],
  "615": [
   {
    "text": "What did you do to her?",
    "speaker": "Jackie Goldman"
   },
   {
    "text": "Jackie! Jackie!",
    "speaker": "Dr. Goldman"
   }
  ],
  "683": [
   {
    "text": "about an incident at work.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "The suicide?",
    "speaker": "Rebecca Gilligan"
   }
  ],
  "696": [
   {
    "text": "Mulder...",
    "speaker": "Dana Scully"
   },
   {
    "text": "What did you say?",
    "speaker": "Rebecca Gilligan"
   }
  ],
  "700": [
   {
    "text": "Get out!",
    "speaker": "Rebecca Gilligan"
   },
   {
    "text": "Mulder, she's making it pretty clear.",
    "speaker": "Dana Scully"
   }
  ],
  "796": [
   {
    "text": "Dad.",
    "speaker": "William"
   },
   {
    "text": "Mmm.",
    "speaker": "Fox Mulder"
   }
  ],
  "809": [
   {
    "text": "You ready?",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Yep.",
    "speaker": "William"
   }
  ]
 },
 "text": {
  "9": "William. ...but had to put him up for adoption",
  "53": "...Do it.",
  "124": "But for now, remove this body so we can secure this room.",
  "274": "I'll submit the report on the suicide",
  "281": "I assume you made copies.",
  "297": "Surveillance footage?",
  "317": "but known to drive the worms up through the soil",
  "355": "I'll agree to relay a message.",
  "484": "Hi, Adam.",
  "500": "I am searching for the key that was the seed",
  "523": "Hit and run, car was moving pretty fast.",
  "555": "by creating alien/human hybrids.",
  "614": "She is safe, so are you, right here with me.",
  "641": "And I knew what I had to do.",
  "738": "Kyle, nobody knows where she is.",
  "792": "What's a \"monolith\"?",
  "795": "I think one day you'll probably have your own ideas about it.",
  "804": "\"But because they are hard.\""
 },
