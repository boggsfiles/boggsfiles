 "splits": {
  "236": [
   {
    "text": "What are you doing?",
    "speaker": "Dana Scully"
   },
   {
    "text": "Gonna take him for a ride.",
    "speaker": "Fox Mulder"
   }
  ],
  "242": [
   {
    "text": "I want you here.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "This isn't my life anymore, Mulder.",
    "speaker": "Dana Scully"
   }
  ],
  "418": [
   {
    "text": "Did you find her?",
    "speaker": "Dana Scully"
   },
   {
    "text": "No.",
    "speaker": "Dakota Whitney"
   }
  ],
  "419": [
   {
    "text": "What did you do?",
    "speaker": "Dana Scully"
   },
   {
    "text": "What?",
    "speaker": "Dakota Whitney"
   }
  ],
  "441": [
   {
    "text": "Mulder.",
    "speaker": "Dana Scully"
   },
   {
    "text": "What?",
    "speaker": "Fox Mulder"
   }
  ],
  "459": [
   {
    "text": "What are you doing?",
    "speaker": "Dana Scully"
   },
   {
    "text": "I'm trying to ignore you.",
    "speaker": "Fox Mulder"
   }
  ],
  "551": [
   {
    "text": "Anything?",
    "speaker": "Dakota Whitney"
   },
   {
    "text": "No, I can't reach her.",
    "speaker": "Fox Mulder"
   }
  ],
  "573": [
   {
    "text": "To go where?",
    "speaker": "Mosley Drummy"
   },
   {
    "text": "I don't know yet.",
    "speaker": "Fox Mulder"
   }
  ],
  "574": [
   {
    "text": "I don't believe this.",
    "speaker": "Mosley Drummy"
   },
   {
    "text": "That's been your problem from the start.",
    "speaker": "Fox Mulder"
   }
  ],
  "596": [
   {
    "text": "We're not quite finished.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "What is that?",
    "speaker": "Dakota Whitney"
   }
  ],
  "826": [
   {
    "text": "Who called you?",
    "speaker": "Fox Mulder"
   },
   {
    "text": "No one.",
    "speaker": "Dana Scully"
   }
  ],
  "831": [
   {
    "text": "In custody?",
    "speaker": "Dana Scully"
   },
   {
    "text": "No.",
    "speaker": "Dakota Whitney"
   }
  ],
  "839": [
   {
    "text": "It's the man in his visions, Scully.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Who?",
    "speaker": "Dana Scully"
   }
  ],
  "891": [
   {
    "text": "Where are you?",
    "speaker": "Dakota Whitney"
   },
   {
    "text": "Right here.",
    "speaker": "Fox Mulder"
   }
  ],
  "897": [
   {
    "text": "I saw him.",
    "speaker": "Dakota Whitney"
   },
   {
    "text": "Where?",
    "speaker": "Fox Mulder"
   }
  ],
  "953": [
   {
    "text": "Hey! Sorry to bother you.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "I'm closed!",
    "speaker": "Feed Store Proprietor"
   }
  ],
  "1064": [
   {
    "text": "Listen.",
    "speaker": "Dana Scully"
   },
   {
    "text": "What?",
    "speaker": "Walter Skinner"
   }
  ],
  "1088": [
   {
    "text": "Skinner?",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Yeah.",
    "speaker": "Walter Skinner"
   }
  ]
 },
