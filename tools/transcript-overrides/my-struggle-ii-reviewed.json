  "620": [
   {
    "text": "from this weapon?",
    "speaker": "Agent Einstein"
   },
   {
    "text": "I don't know.",
    "speaker": "Dana Scully"
   }
  ]
 },
 "text": {
  "34": "I am a special agent with the Federal Bureau of Investigation,",
  "110": "Alien DNA lurking in every American citizen.",
  "149": "My prejudices are only against pseudoscience.",
  "304": "I am seeing one class of people infected.",
  "324": "I can explain what's happening.",
  "399": "Now that I have you to light my smokes.",
  "557": "I'll miss you dearly.",
  "579": "It was near the centromere on chromosome 17.",
  "615": "CRISPR-Cas9.",
  "691": "Yes, I am, Agent Einstein.",
  "728": "I don't know how I'm gonna find you."
