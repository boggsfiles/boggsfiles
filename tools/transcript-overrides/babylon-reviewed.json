  "199": [
   {
    "text": "I will not...",
    "speaker": "TV Panelist"
   },
   {
    "text": "Okay.",
    "speaker": "TV Panelist"
   }
  ],
  "279": [
   {
    "text": "from Columbia University to Oxford.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Oh. (SNICKERS)",
    "speaker": "Agent Einstein"
   }
  ],
  "414": [
   {
    "text": "Agent Miller?",
    "speaker": "Agent Brem"
   },
   {
    "text": "Yes. Is there a problem?",
    "speaker": "Agent Miller"
   }
  ],
  "473": [
   {
    "text": "That sounds very suspicious.",
    "speaker": "Agent Einstein"
   },
   {
    "text": "Mmm. Yeah.",
    "speaker": "Nurse"
   }
  ],
  "569": [
   {
    "text": "What are you talking about?",
    "speaker": "Fox Mulder"
   },
   {
    "text": "What am I talking about?",
    "speaker": "Walter Skinner"
   }
  ],
  "593": [
   {
    "text": "What I gave you is a placebo.",
    "speaker": "Agent Einstein"
   },
   {
    "text": "No way.",
    "speaker": "Fox Mulder"
   }
  ],
  "606": [
   {
    "text": "You talked to the terrorist?",
