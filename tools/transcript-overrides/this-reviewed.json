 "splits": {
  "15": [
   {
    "text": "Mulder.",
    "speaker": "Richard Langly"
   },
   {
    "text": "Hmm.",
    "speaker": "Fox Mulder"
   }
  ],
  "18": [
   {
    "text": "Hmm.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "...Mulder.",
    "speaker": "Richard Langly"
   }
  ],
  "20": [
   {
    "text": "Fox Mulder.",
    "speaker": "Richard Langly"
   },
   {
    "text": "Langly?",
    "speaker": "Fox Mulder"
   }
  ],
  "51": [
   {
    "text": "You all right?",
    "speaker": "Fox Mulder"
   },
   {
    "text": "There's one in the room.",
    "speaker": "Dana Scully"
   }
  ],
  "65": [
   {
    "text": "Better call it in from a landline.",
    "speaker": "Dana Scully"
   },
   {
    "text": "Yeah.",
    "speaker": "Fox Mulder"
   }
  ],
  "91": [
   {
    "text": "Their bodies were incinerated.",
    "speaker": "Dana Scully"
   },
   {
    "text": "It's gotta be connected.",
    "speaker": "Fox Mulder"
   }
  ],
  "105": [
   {
    "text": "The Critical Incident Response Group?",
    "speaker": "Dana Scully"
   },
   {
    "text": "Never.",
    "speaker": "Fox Mulder"
   }
  ],
  "106": [
   {
    "text": "I got 14 rounds.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Eight.",
    "speaker": "Dana Scully"
   }
  ],
  "117": [
   {
    "text": "Hello?",
    "speaker": "Walter Skinner"
   },
   {
    "text": "Skinner, it's Scully. I'm with Mulder.",
    "speaker": "Dana Scully"
   }
  ],
  "118": [
   {
    "text": "Listen to me, Scully.",
    "speaker": "Walter Skinner"
   },
   {
    "text": "You don't have much time.",
    "speaker": "Perlu Commander"
   }
  ],
  "130": [
   {
    "text": "I don't know.",
    "speaker": "Dana Scully"
   },
   {
    "text": "Why are we under suspicion?",
    "speaker": "Fox Mulder"
   }
  ],
  "162": [
   {
    "text": "Richard Langly.",
    "speaker": "Richard Langly"
   },
   {
    "text": "Ringo Langly, I need to know.",
    "speaker": "Richard Langly"
   }
  ],
  "207": [
   {
    "text": "Frohike.",
    "speaker": "Dana Scully"
   },
   {
    "text": "What are we looking for, Mulder?",
    "speaker": "Dana Scully"
   }
  ],
  "254": [
   {
    "text": "What is that?",
    "speaker": "Dana Scully"
   },
   {
    "text": "Mm-hm.",
    "speaker": "Fox Mulder"
   }
  ],
  "277": [
   {
    "text": "An X-file?",
    "speaker": "Dana Scully"
   },
   {
    "text": "Mm-hm.",
    "speaker": "Fox Mulder"
   }
  ],
  "300": [
   {
    "text": "We can't go to our home.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "They'll be waiting for us at our office.",
    "speaker": "Fox Mulder"
   }
  ],
  "315": [
   {
    "text": "Why didn't you tell us?",
    "speaker": "Fox Mulder"
   },
   {
    "text": "The X-files belonged to us.",
    "speaker": "Fox Mulder"
   }
  ],
  "402": [
   {
    "text": "Whoa, whoa, whoa. Sorry.",
    "speaker": "Dana Scully"
   },
   {
    "text": "Come on.",
    "speaker": "Man"
   }
  ],
  "426": [
   {
    "text": "Dana Scully?",
    "speaker": "Richard Langly"
   },
   {
    "text": "Heh.",
    "speaker": "Fox Mulder"
   }
  ],
  "469": [
   {
    "text": "That was fun.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Uh--",
    "speaker": "Dana Scully"
   }
  ],
  "480": [
   {
    "text": "I can take him upstairs to Holding.",
    "speaker": "Agent Colquitt"
   },
   {
    "text": "No, I'm taking him to Titanpointe.",
    "speaker": "Dana Scully"
   }
  ],
  "617": [
   {
    "text": "They know that we know.",
    "speaker": "Richard Langly"
   },
   {
    "text": "Destroy the backup.",
    "speaker": "Richard Langly"
   }
  ]
 },
 "text": {
  "1": "[RAMONES' \"CALIFORNIA SUN\" PLAYING OVER RADIO]",
  "22": "I believe-- I believe you knew me as Langly.",
  "34": "If I am, they know that I know.",
  "63": "If I am...",
  "74": "Wallace Road.",
  "87": "...burial in the Arlington Cemetery.",
  "141": "[MAN 2 SPEAKS IN RUSSIAN]",
  "142": "[MAN 3 SPEAKS IN RUSSIAN]",
  "143": "[MAN 2 SPEAKS IN RUSSIAN]",
  "144": "[IN ENGLISH] Where's your phone, bro?",
  "192": "Take it.",
  "216": "Frohike looked 57 the day he was born.",
  "223": "JFK was the 35th president, Eisenhower was the 34th president, FDR--",
  "234": "...two...",
  "238": "This is it.",
  "251": "...in a graveyard that he didn't even know he was gonna be buried in?",
  "346": "...hadn't seen you in five years, then I never would and I could...",
  "390": "...using video signal manipulation to my cell.",
  "396": "[GROANING]",
  "401": "[THE RIVIERAS' \"CALIFORNIA SUN\" PLAYING OVER SPEAKER]",
  "496": "...by an exhaust opening.",
  "527": "...isn't about this is black, and this white.",
  "547": "Its reason for being is to advance life, not end it.",
  "569": "Very few have ever seen it, and those that do, don't realize what it is.",
  "589": "[ALARM CONTINUES BLARING]",
  "620": "[RAMONES' \"CALIFORNIA SUN\" PLAYING]"
 },
