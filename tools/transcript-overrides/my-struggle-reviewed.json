 "splits": {
  "57": [
   {
    "text": "Dr. Scully?",
    "speaker": "O.R. Nurse"
   },
   {
    "text": "Yes.",
    "speaker": "Dana Scully"
   }
  ],
  "112": [
   {
    "text": "Fox Mulder?",
    "speaker": "Tad O'Malley"
   },
   {
    "text": "Yes.",
    "speaker": "Fox Mulder"
   }
  ],
  "195": [
   {
    "text": "Hi.",
    "speaker": "Dana Scully"
   },
   {
    "text": "Hello.",
    "speaker": "Fox Mulder"
   }
  ],
  "309": [
   {
    "text": "High cholesterol.",
    "speaker": "Dana Scully"
   }
  ],
  "310": [
   {
    "text": "Sorry to barge in on you like this.",
    "speaker": "Tad O'Malley"
   }
  ],
  "363": [
   {
    "text": "Men.",
    "speaker": "Sveta"
   },
   {
    "text": "Men? Humans?",
    "speaker": "Fox Mulder"
   }
  ],
  "450": [
   {
    "text": "I need you to do something.",
    "speaker": "Dana Scully"
   },
   {
    "text": "Of course.",
    "speaker": "O.R. Nurse"
   }
  ],
  "479": [
   {
    "text": "So you believe you have the how.",
    "speaker": "Old Man"
   },
   {
    "text": "Yes.",
    "speaker": "Fox Mulder"
   }
  ],
  "486": [
   {
    "text": "This is old news.",
    "speaker": "Old Man"
   },
   {
    "text": "The countdown has begun.",
    "speaker": "Fox Mulder"
   }
  ],
  "540": [
   {
    "text": "He's a player.",
    "speaker": "Dana Scully"
   },
   {
    "text": "He's been a godsend.",
    "speaker": "Fox Mulder"
   }
  ],
  "722": [
   {
    "text": "Skinner.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Skinner.",
    "speaker": "Dana Scully"
   }
  ]
 },
 "text": {
  "65": "If I was the president,",
  "136": "I had the vehicle bulletproofed.",
  "193": "Sveta, this is Dana Scully and Fox Mulder.",
  "204": "Please, come in.",
  "227": "I have alien DNA. For sure.",
  "296": "Technology kept secret for 70 years",
  "319": "So it's a genetic deformity?",
  "329": "I've never felt so alive.",
  "394": "Sveta is the key to everything.",
  "456": "Oh, and I'm expecting a call.",
  "472": "I saw an ARV running on free energy. I saw it disappear.",
  "550": "She's the key to everything. Sveta is the key.",
  "575": "that a new threat started appearing in skies over America,",
  "580": "in spaceships using electrogravitic propulsion.",
  "583": "forestalling our annihilation through their own self-sacrifice.",
  "662": "so bogus and dangerous and stupid",
  "677": "I am so sorry if I misled anyone.",
  "4": "Since my sister disappeared when I was 12 years old,"
 },
