        "text": "ASCENDING TO THE STARS."
      },
      {
        "speaker": "Krycek",
        "text": "WHAT IS IT ?"
      }
    ],
    "143.0": [
      {
        "speaker": "Fox Mulder",
        "text": "DOESN'T ROUTE 229 LEAD TO THE BLUE RIDGE PARKWAY ?"
      },
      {
        "speaker": "Krycek",
        "text": "I DON'T KNOW."
      }
    ],
    "148.0": [
      {
        "speaker": "Krycek",
        "text": "WHERE ARE WE GOING ?"
      },
      {
        "speaker": "Fox Mulder",
        "text": "JUST GET YOUR CAR."
      }
    ],
    "149.0": [
      {
        "speaker": "Krycek",
        "text": "WHAT ABOUT SKINNER ?"
      },
      {
        "speaker": "Fox Mulder",
        "text": "I'LL DEAL WITH SKINNER."
      }
    ],
    "156.0": [
      {
        "speaker": "Krycek",
        "text": "MAYBE I SHOULD DRIVE."
      },
      {
        "speaker": "Fox Mulder",
        "text": "I'M FINE."
      }
    ],
    "157.0": [
      {
        "speaker": "Krycek",
        "text": "YOU HAVEN'T SLEPT YET. I HAVE."
      },
      {
        "speaker": "Fox Mulder",
        "text": "I SAID I'M FINE."
      }
    ],
    "176.0": [
      {
