 "splits": {
  "49": [
   {
    "text": "What does the other guy look like?",
    "speaker": "Dana Scully"
   },
   {
    "text": "Funny you should ask.",
    "speaker": "Fox Mulder"
   }
  ],
  "93": [
   {
    "text": "...and he floored the gas.",
    "speaker": "Arkie Seavers"
   },
   {
    "text": "And by \"he,\" you mean...?",
    "speaker": "Fox Mulder"
   }
  ],
  "94": [
   {
    "text": "I mean, the dude looked just like me.",
    "speaker": "Arkie Seavers"
   },
   {
    "text": "And you'd seen him before.",
    "speaker": "Fox Mulder"
   }
  ],
  "99": [
   {
    "text": "And do you take drugs, Arkie?",
    "speaker": "Dana Scully"
   },
   {
    "text": "No, I'm-- Eh.",
    "speaker": "Arkie Seavers"
   }
  ],
  "101": [
   {
    "text": "And you're in jail because...?",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Arkie admittedly has a problem.",
    "speaker": "Dean Cavalier"
   }
  ],
  "110": [
   {
    "text": "What do you chalk that up to?",
    "speaker": "Fox Mulder"
   },
   {
    "text": "I can tell you.",
    "speaker": "Arkie Seavers"
   }
  ],
  "120": [
   {
    "text": "...and applying the brakes there.",
    "speaker": "Dana Scully"
   },
   {
    "text": "But if he was asleep...",
    "speaker": "Fox Mulder"
   }
  ],
  "122": [
   {
    "text": "You're saying you believe him.",
    "speaker": "Dana Scully"
   },
   {
    "text": "No.",
    "speaker": "Fox Mulder"
   }
  ],
  "128": [
   {
    "text": "They never received treatment.",
    "speaker": "Dr. Russell"
   },
   {
    "text": "So there were issues?",
    "speaker": "Dana Scully"
   }
  ],
  "135": [
   {
    "text": "They became mentally ill.",
    "speaker": "Dr. Russell"
   },
   {
    "text": "It was almost like a kind of outbreak.",
    "speaker": "Dr. Russell"
   }
  ],
  "144": [
   {
    "text": "Could we possibly talk to her?",
    "speaker": "Fox Mulder"
   },
   {
    "text": "I'd strongly advise against that.",
    "speaker": "Dr. Russell"
   }
  ],
  "145": [
   {
    "text": "Why would you say that?",
    "speaker": "Dana Scully"
   },
   {
    "text": "Because she exhibits split personality...",
    "speaker": "Dr. Russell"
   }
  ],
  "153": [
   {
    "text": "I look awful. I look a fright.",
    "speaker": "Judy Poundstone"
   },
   {
    "text": "No one's judging you, Judy.",
    "speaker": "Dr. Russell"
   }
  ],
  "159": [
   {
    "text": "That's what my fans call me.",
    "speaker": "Judy Poundstone"
   },
   {
    "text": "Are you an actress, Judy?",
    "speaker": "Dana Scully"
   }
  ],
  "192": [
   {
    "text": "Do you have reservations?",
    "speaker": "Receptionist"
   },
   {
    "text": "No.",
    "speaker": "Dana Scully"
   }
  ],
  "212": [
   {
    "text": "Looks like a suicide.",
    "speaker": "Guard"
   },
   {
    "text": "He was strangled to death.",
    "speaker": "Dean Cavalier"
   }
  ],
  "220": [
   {
    "text": "We're working on it.",
    "speaker": "Dana Scully"
   },
   {
    "text": "Well, someone's gotta pay.",
    "speaker": "Dean Cavalier"
   }
  ],
  "246": [
   {
    "text": "...he'd red-tag you--",
    "speaker": "Fox Mulder"
   },
   {
    "text": "You calling the marshal?",
    "speaker": "Chucky Poundstone"
   }
  ],
  "260": [
   {
    "text": "I take it you're twins.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Ooh.",
    "speaker": "Chucky Poundstone"
   }
  ],
  "261": [
   {
    "text": "Powers of deduction.",
    "speaker": "Chucky Poundstone"
   },
   {
    "text": "And she's the good twin.",
    "speaker": "Fox Mulder"
   }
  ],
  "286": [
   {
    "text": "I'm not afraid of you, Judy.",
    "speaker": "Dana Scully"
   },
   {
    "text": "Oh, yes, you are.",
    "speaker": "Judy Poundstone"
   }
  ],
  "290": [
   {
    "text": "And what about your brother?",
    "speaker": "Dana Scully"
   },
   {
    "text": "Is he involved?",
    "speaker": "Dana Scully"
   }
  ],
  "306": [
   {
    "text": "How old are you, 40s?",
    "speaker": "Judy Poundstone"
   },
   {
    "text": "Past your childbearing years.",
    "speaker": "Judy Poundstone"
   }
  ],
  "334": [
   {
    "text": "Mulder, do you think of me as old?",
    "speaker": "Dana Scully"
   },
   {
    "text": "What? Where is that coming from?",
    "speaker": "Fox Mulder"
   }
  ],
  "355": [
   {
    "text": "You choose them at the jail, don't you?",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Losers like Arkie Seavers...",
    "speaker": "Fox Mulder"
   }
  ],
  "361": [
   {
    "text": "Intent to commit a crime.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Heh. I've seen many a bad jailhouse lawyer...",
    "speaker": "Chucky Poundstone"
   }
  ],
  "365": [
   {
    "text": "That's original. I haven't heard that before.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Before I punch you in the face...",
    "speaker": "Chucky Poundstone"
   }
  ],
  "366": [
   {
    "text": "...and snatch Little Red Riding Hood.",
    "speaker": "Chucky Poundstone"
   },
   {
    "text": "There's the Chucky I came for.",
    "speaker": "Fox Mulder"
   }
  ],
  "368": [
   {
    "text": "Judy? Excuse me, hon.",
    "speaker": "Nurse Peggy"
   },
   {
    "text": "Agent Scully's here to see you.",
    "speaker": "Nurse Peggy"
   }
  ],
  "372": [
   {
    "text": "You look mad at me.",
    "speaker": "Judy Poundstone"
   },
   {
    "text": "I am mad, Judy. I am...",
    "speaker": "Dana Scully"
   }
  ],
  "374": [
   {
    "text": "...and I don't know how.",
    "speaker": "Dana Scully"
   },
   {
    "text": "And you blame me, don't you?",
    "speaker": "Judy Poundstone"
   }
  ],
  "381": [
   {
    "text": "No, she's not.",
    "speaker": "Dana Scully"
   },
   {
    "text": "Sure she is. Just look.",
    "speaker": "Judy Poundstone"
   }
  ],
  "401": [
   {
    "text": "...and that they have secret powers.",
    "speaker": "Dana Scully"
   },
   {
    "text": "That's really only half true.",
    "speaker": "Nurse Peggy"
   }
  ],
  "405": [
   {
    "text": "They have no medicinal qualities.",
    "speaker": "Dana Scully"
   },
   {
    "text": "No. Not that we know of, anyway.",
    "speaker": "Nurse Peggy"
   }
  ],
  "415": [
   {
    "text": "Only good when they're appealing.",
    "speaker": "Waitress"
   },
   {
    "text": "I gotta have you over to my place...",
    "speaker": "Dean Cavalier"
   }
  ],
  "416": [
   {
    "text": "...to see my sword collection.",
    "speaker": "Dean Cavalier"
   },
   {
    "text": "You say that to all the girls.",
    "speaker": "Waitress"
   }
  ],
  "423": [
   {
    "text": "Was it the first time?",
    "speaker": "Fox Mulder"
   },
   {
    "text": "No, no, I think I saw him the other day...",
    "speaker": "Dean Cavalier"
   }
  ],
  "424": [
   {
    "text": "...staring at me from a bus stop.",
    "speaker": "Dean Cavalier"
   },
   {
    "text": "You're making it worse.",
    "speaker": "Dana Scully"
   }
  ],
  "425": [
   {
    "text": "I'm making it worse? This guy is stalking me.",
    "speaker": "Dean Cavalier"
   },
   {
    "text": "Your paranoia is gonna feed on itself.",
    "speaker": "Dana Scully"
   }
  ],
  "427": [
   {
    "text": "Those people all died.",
    "speaker": "Dean Cavalier"
   },
   {
    "text": "While I agree with Agent Scully's theory...",
    "speaker": "Fox Mulder"
   }
  ],
  "449": [
   {
    "text": "Speak for yourself, Scully.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "And tell that to Chuck and Judy.",
    "speaker": "Fox Mulder"
   }
  ],
  "527": [
   {
    "text": "...and have kids.",
    "speaker": "Dana Scully"
   },
   {
    "text": "Mm.",
    "speaker": "Fox Mulder"
   }
  ],
  "543": [
   {
    "text": "...and we're the only two who can save it.",
    "speaker": "Dana Scully"
   },
   {
    "text": "The world is going to hell, Scully.",
    "speaker": "Fox Mulder"
   }
  ],
  "553": [
   {
    "text": "Earth to Judith.",
    "speaker": "Chucky Poundstone"
   },
   {
    "text": "Yes, Your Royal Highness, there is an L.",
    "speaker": "Chucky Poundstone"
   }
  ],
  "558": [
   {
    "text": "What are you talking about?",
    "speaker": "Dana Scully"
   },
   {
    "text": "I was looking in the mirror, and there he was.",
    "speaker": "Fox Mulder"
   }
  ],
  "560": [
   {
    "text": "I know. I saw my double too.",
    "speaker": "Dana Scully"
   },
   {
    "text": "They're targeting us both.",
    "speaker": "Dana Scully"
   }
  ],
  "563": [
   {
    "text": "Mulder, you have to calm down.",
    "speaker": "Dana Scully"
   },
   {
    "text": "Scully.",
    "speaker": "Fox Mulder"
   }
  ],
  "565": [
   {
    "text": "They can't hang us.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "We can only hang ourselves if we panic.",
    "speaker": "Dana Scully"
   }
  ],
  "571": [
   {
    "text": "You know you're in love with him.",
    "speaker": "Chucky Poundstone"
   },
   {
    "text": "Double L, Chuck-face.",
    "speaker": "Judy Poundstone"
   }
  ],
  "577": [
   {
    "text": "I know you're in here.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "I said, no letter C.",
    "speaker": "Chucky Poundstone"
   }
  ],
  "613": [
   {
    "text": "Okay.",
    "speaker": "Dana Scully"
   },
   {
    "text": "Yeah.",
    "speaker": "Fox Mulder"
   }
  ]
 },
