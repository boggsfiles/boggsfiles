 },
 "splits": {
  "7": [
   {
    "text": "Oh. Aah!",
    "speaker": "Dana Scully"
   },
   {
    "text": "Scully?",
    "speaker": "Fox Mulder"
   }
  ],
  "9": [
   {
    "text": "Tell me what you saw.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "A plague will be released.",
    "speaker": "Dana Scully"
   }
  ],
  "12": [
   {
    "text": "You can't stop what's begun.",
    "speaker": "Cigarette-Smoking Man"
   },
   {
    "text": "You've always had your enemies.",
    "speaker": "Monica Reyes"
   }
  ],
  "16": [
   {
    "text": "He wants to exterminate humanity.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "What's your enterprise?",
    "speaker": "Fox Mulder"
   }
  ],
  "19": [
   {
    "text": "Kill him.",
    "speaker": "Mr. Y"
   },
   {
    "text": "You're his son.",
    "speaker": "Erika Price"
   }
  ],
  "24": [
   {
    "text": "Who's the father?",
    "speaker": "Walter Skinner"
   },
   {
    "text": "William is my son.",
    "speaker": "Cigarette-Smoking Man"
   }
  ],
  "85": [
   {
    "text": "What I need right now is answers.",
    "speaker": "William"
   },
   {
    "text": "Jackson?",
    "speaker": "Dana Scully"
   }
  ],
  "101": [
   {
    "text": "Checked in this evening.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Paid me in hundreds.",
    "speaker": "Motel Manager"
   }
  ],
  "109": [
   {
    "text": "\"Death will hunt you down.\"",
    "speaker": "Alvin Kersh"
   },
   {
    "text": "That's a quote from Mulder.",
    "speaker": "Alvin Kersh"
   }
  ],
  "111": [
   {
    "text": "You're his superior.",
    "speaker": "Alvin Kersh"
   },
   {
    "text": "You're supposed to be in charge.",
    "speaker": "Alvin Kersh"
   }
  ],
  "117": [
   {
    "text": "What if it's not just fake news?",
    "speaker": "Walter Skinner"
   },
   {
    "text": "I don't care if it is true.",
    "speaker": "Alvin Kersh"
   }
  ],
  "118": [
   {
    "text": "That's someone else's problem.",
    "speaker": "Alvin Kersh"
   },
   {
    "text": "We're not gonna see panic in the streets.",
    "speaker": "Alvin Kersh"
   }
  ],
  "120": [
   {
    "text": "Skinner.",
    "speaker": "Cigarette-Smoking Man"
   },
   {
    "text": "I promised you a global contagion.",
    "speaker": "Cigarette-Smoking Man"
   }
  ],
  "127": [
   {
    "text": "Why aren't you answering?",
    "speaker": "Walter Skinner"
   },
   {
    "text": "I've been getting my ass chewed.",
    "speaker": "Walter Skinner"
   }
  ],
  "133": [
   {
    "text": "He needs your help. I need your help.",
    "speaker": "Dana Scully"
   },
   {
    "text": "I've been told to shut you down.",
    "speaker": "Walter Skinner"
   }
  ],
  "134": [
   {
    "text": "What are you talking about?",
    "speaker": "Dana Scully"
   },
   {
    "text": "I've been asked to take your badges.",
    "speaker": "Walter Skinner"
   }
  ],
  "135": [
   {
    "text": "Who said that? Kersh?",
    "speaker": "Dana Scully"
   },
   {
    "text": "Is he in there?",
    "speaker": "Dana Scully"
   }
  ],
  "136": [
   {
    "text": "Dana--",
    "speaker": "Walter Skinner"
   },
   {
    "text": "He doesn't understand what's happening.",
    "speaker": "Dana Scully"
   }
  ],
  "145": [
   {
    "text": "I'll put you on speaker phone.",
    "speaker": "Dana Scully"
   },
   {
    "text": "Who's on the phone?",
    "speaker": "Fox Mulder"
   }
  ],
  "154": [
   {
    "text": "He's not on that plane, Mulder.",
    "speaker": "Dana Scully"
   },
   {
    "text": "You have any reason to distrust her?",
    "speaker": "Fox Mulder"
   }
  ],
  "155": [
   {
    "text": "Is there word on the boy?",
    "speaker": "Cigarette-Smoking Man"
   },
   {
    "text": "Nothing. Nothing to report.",
    "speaker": "Monica Reyes"
   }
  ],
  "176": [
   {
    "text": "How the hell did you get in here?",
    "speaker": "Mr. Y"
   },
   {
    "text": "You can't keep this a secret for long.",
    "speaker": "Fox Mulder"
   }
  ],
  "210": [
   {
    "text": "Eight recent winners in a 10-mile radius.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Where was the last winner?",
    "speaker": "Dana Scully"
   }
  ],
  "218": [
   {
    "text": "Says he'll split it with her. He did too.",
    "speaker": "Attendant"
   },
   {
    "text": "So he came back. When was that?",
    "speaker": "Fox Mulder"
   }
  ],
  "220": [
   {
    "text": "...which is why I'm cleaning toilets.",
    "speaker": "Attendant"
   },
   {
    "text": "You have security cameras?",
    "speaker": "Fox Mulder"
   }
  ],
  "230": [
   {
    "text": "I'm two hours behind him.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "I got the direction he's headed.",
    "speaker": "Fox Mulder"
   }
  ],
  "231": [
   {
    "text": "They're heading northeast.",
    "speaker": "Dana Scully"
   },
   {
    "text": "That's exactly what I'm thinking.",
    "speaker": "Fox Mulder"
   }
  ],
  "234": [
   {
    "text": "Every last thing in the world.",
    "speaker": "Dana Scully"
   },
   {
    "text": "I'm gonna find him.",
    "speaker": "Fox Mulder"
   }
  ],
  "249": [
   {
    "text": "Hello?",
    "speaker": "Tad O'Malley"
   },
   {
    "text": "It's Dana Scully.",
    "speaker": "Dana Scully"
   }
  ],
  "250": [
   {
    "text": "I'm just about to go on here.",
    "speaker": "Tad O'Malley"
   },
   {
    "text": "I want you to listen to me.",
    "speaker": "Dana Scully"
   }
  ],
  "251": [
   {
    "text": "Can I call you right back?",
    "speaker": "Tad O'Malley"
   },
   {
    "text": "You're looking for a conspiracy? Here it is.",
    "speaker": "Dana Scully"
   }
  ],
  "263": [
   {
    "text": "Where are you getting this information?",
    "speaker": "Tad O'Malley"
   },
   {
    "text": "A man-made contagion...",
    "speaker": "Dana Scully"
   }
  ],
  "273": [
   {
    "text": "You realize how crazy this sounds?",
    "speaker": "Tad O'Malley"
   },
   {
    "text": "Death in the streets, Mr. O'Malley.",
    "speaker": "Dana Scully"
   }
  ],
  "285": [
   {
    "text": "Mulder?",
    "speaker": "Dana Scully"
   },
   {
    "text": "I lost him.",
    "speaker": "Fox Mulder"
   }
  ],
  "288": [
   {
    "text": "You're in grave danger.",
    "speaker": "Dana Scully"
   },
   {
    "text": "No, I'm too close now.",
    "speaker": "Fox Mulder"
   }
  ],
  "291": [
   {
    "text": "You're not listening.",
    "speaker": "Dana Scully"
   },
   {
    "text": "You're not listening to me.",
    "speaker": "Dana Scully"
   }
  ],
  "293": [
   {
    "text": "He probably hitched another ride.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "I'm not that far behind him.",
    "speaker": "Fox Mulder"
   }
  ],
  "294": [
   {
    "text": "Mulder.",
    "speaker": "Dana Scully"
   },
   {
    "text": "I got to go.",
    "speaker": "Fox Mulder"
   }
  ],
  "307": [
   {
    "text": "I just have to talk to you, Sarah.",
    "speaker": "William"
   },
   {
    "text": "How come you didn't call her?",
    "speaker": "Brianna"
   }
  ],
  "309": [
   {
    "text": "You're up past your bedtime.",
    "speaker": "William"
   },
   {
    "text": "Mm.",
    "speaker": "Maddy"
   }
  ],
  "310": [
   {
    "text": "Look, I had to ditch my phone.",
    "speaker": "William"
   },
   {
    "text": "Heh.",
    "speaker": "Brianna"
   }
  ],
  "312": [
   {
    "text": "Look, I can explain everything.",
    "speaker": "William"
   },
   {
    "text": "Please, it's cold. I--",
    "speaker": "William"
   }
  ],
  "317": [
   {
    "text": "Look, we broke up.",
    "speaker": "Brianna"
   },
   {
    "text": "Has he called?",
    "speaker": "Fox Mulder"
   }
  ],
  "318": [
   {
    "text": "We don't talk anymore.",
    "speaker": "Brianna"
   },
   {
    "text": "I need you to be honest.",
    "speaker": "Fox Mulder"
   }
  ],
  "336": [
   {
    "text": "Yeah, because I'm some kind of freak.",
    "speaker": "William"
   },
   {
    "text": "Stop it.",
    "speaker": "Sarah"
   }
  ],
  "338": [
   {
    "text": "...a freak.",
    "speaker": "Sarah"
   },
   {
    "text": "Yes, I am.",
    "speaker": "William"
   }
  ],
  "339": [
   {
    "text": "No.",
    "speaker": "Sarah"
   },
   {
    "text": "Okay, yeah. You've seen what I can do, Sarah.",
    "speaker": "William"
   }
  ],
  "344": [
   {
    "text": "I could jump off a bridge, or--",
    "speaker": "William"
   },
   {
    "text": "What can I say to stop you?",
    "speaker": "Sarah"
   }
  ],
  "350": [
   {
    "text": "I can't talk now.",
    "speaker": "Sarah"
   },
   {
    "text": "I have money.",
    "speaker": "William"
   }
  ],
  "353": [
   {
    "text": "I can meet you somewhere.",
    "speaker": "William"
   },
   {
    "text": "Mm-hm.",
    "speaker": "Sarah"
   }
  ],
  "374": [
   {
    "text": "Okay, so how'd you find me now?",
    "speaker": "William"
   },
   {
    "text": "Doesn't matter.",
    "speaker": "Fox Mulder"
   }
  ],
  "378": [
   {
    "text": "I held you when you were a baby.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Maybe you did, but I don't remember that.",
    "speaker": "William"
   }
  ],
  "388": [
   {
    "text": "Yeah, because I'm a danger to people.",
    "speaker": "William"
   },
   {
    "text": "I can help with that.",
    "speaker": "Fox Mulder"
   }
  ],
  "399": [
   {
    "text": "All right?",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Because you die too.",
    "speaker": "William"
   }
  ],
  "402": [
   {
    "text": "You have to live.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "I know you think you're helping me.",
    "speaker": "William"
   }
  ],
  "404": [
   {
    "text": "Okay. It's too late.",
    "speaker": "William"
   },
   {
    "text": "Listen. You gotta go.",
    "speaker": "William"
   }
  ],
  "405": [
   {
    "text": "I'm not leaving.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Get back there, get down.",
    "speaker": "Fox Mulder"
   }
  ],
  "418": [
   {
    "text": "Mulder.",
    "speaker": "Dana Scully"
   },
   {
    "text": "You can't believe what just happened.",
    "speaker": "Fox Mulder"
   }
  ],
  "419": [
   {
    "text": "You seeing this?",
    "speaker": "Fox Mulder"
   },
   {
    "text": "I lost him, Scully.",
    "speaker": "Fox Mulder"
   }
  ],
  "420": [
   {
    "text": "He's gone.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Just tell me where you are.",
    "speaker": "Dana Scully"
   }
  ],
  "447": [
   {
    "text": "Let me talk to Sarah.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "I said she can't talk.",
    "speaker": "Man"
   }
  ],
  "457": [
   {
    "text": "Something you may not want to hear.",
    "speaker": "Walter Skinner"
   },
   {
    "text": "It's about your son and who his father is.",
    "speaker": "Walter Skinner"
   }
  ],
  "482": [
   {
    "text": "He's here.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "I know. I just saw him.",
    "speaker": "Dana Scully"
   }
  ],
  "483": [
   {
    "text": "He doesn't want to be found.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "I just want to talk to him, Mulder.",
    "speaker": "Dana Scully"
   }
  ],
  "489": [
   {
    "text": "What are you talking about?",
    "speaker": "Dana Scully"
   },
   {
    "text": "Nothing we can do.",
    "speaker": "Fox Mulder"
   }
  ],
  "490": [
   {
    "text": "We can protect him.",
    "speaker": "Dana Scully"
   },
   {
    "text": "No, we can't protect him. No one can.",
    "speaker": "Fox Mulder"
   }
  ],
  "506": [
   {
    "text": "But then you have so much to lose.",
    "speaker": "Cigarette-Smoking Man"
   },
   {
    "text": "It's what we have in common.",
    "speaker": "Fox Mulder"
   }
  ],
  "521": [
   {
    "text": "I don't think you can do it.",
    "speaker": "Fox Mulder"
   },
   {
    "text": "Then you don't know me very well.",
    "speaker": "Cigarette-Smoking Man"
   }
  ]
 },
 "text": {
  "32": "I've never really met her properly, but I can feel her in these--",
  "47": "...powers.",
  "69": "...I'm my father, all of a sudden.",
  "75": "...until I decided to play a stupid joke on these two girls.",
  "84": "...if they catch me.",
  "112": "I am in charge.",
  "113": "I'll see if I can find Agent Scully--\nYou find her.",
  "116": "--a motel manager reporting a military-style incursion.",
  "123": "So if I find him, will it stop?",
  "144": "...if I don't know what's going on.",
  "148": "Tennessee.\nBeing transported by a private jet.",
  "223": "DANA: William.\nWILLIAM: You can't help me.",
  "233": "Everything depends on it.",
  "290": "I-- I think I know where he's going.",
  "323": "I need to know where he is.",
  "340": "They want me for that. Catch me, put me in a cage.",
  "363": "Sarah, I need to know where he is.",
  "391": "WILLIAM: I've seen the future, all right? I have visions.",
  "392": "I know what happens if they catch me, all the people who are gonna die.",
  "397": "It's not your fault.\nYes, it is.",
  "398": "Then let me help you stop it.\nYou can't.",
  "425": "I know he will.",
  "427": "I'm supposed to rein you in.",
  "435": "...as his superiors label it fake news. Shocker.",
  "444": "A bloodbath so insane...",
  "445": "...it can only point to a conspiracy, the likes of which the world has never seen.",
  "463": "I-- I don't know.",
  "485": "I know what he's afraid of.",
  "542": "...born in a laboratory.",
  "559": "I know it is."
 },
